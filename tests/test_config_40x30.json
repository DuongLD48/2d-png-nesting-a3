{
  "canvas": {
    "paper_size": "40x30cm",
    "width_mm": 400.0,
    "height_mm": 300.0,
    "dpi": 150,
    "margin_top_mm": 5.0,
    "margin_bottom_mm": 5.0,
    "margin_left_mm": 5.0,
    "margin_right_mm": 5.0,
    "background_color_rgba": [
      255,
      255,
      255,
      0
    ]
  },
  "preprocessing": {
    "alpha_threshold": 10,
    "auto_scale_oversized": false
  },
  "nesting": {
    "padding_mm": 3.0,
    "enable_360_rotation": true,
    "rotation_step_deg": 90,
    "rotation_angles_deg": [
      0,
      90,
      180,
      270
    ],
    "search_step_px": 10
  },
  "sorting": {
    "primary_key": "area",
    "reverse": true
  },
  "quality_check": {
    "allow_overlap": false,
    "enforce_margins": true,
    "tolerance_px": 2.0
  },
  "paths": {
    "input_folder": "tests/test_png_40x30",
    "output_folder": "output_test"
  }
}